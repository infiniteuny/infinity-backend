APP_NAME="INFINITE UNY"
APP_ENV=local
APP_KEY=<needed>
APP_DEBUG=true
APP_URL=<needed>
API_URL=<needed>
API_FREEPIK_URL=
API_FREEPIK_ERROR_NOTIF_URL=

ANALYTICS_VIEW_ID=<needed>

GOOGLE_CLIENT_ID=<needed>
GOOGLE_CLIENT_SECRET=<needed>
GOOGLE_REDIRECT_URI=<needed>

AUTHENTIK_BASE_URL=<needed>
AUTHENTIK_CLIENT_ID=<needed>
AUTHENTIK_CLIENT_SECRET=<needed>
AUTHENTIK_REDIRECT_URI=<needed>

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
